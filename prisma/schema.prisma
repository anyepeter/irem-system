generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
  TECHNICIAN
}

enum TicketStatus {
  PENDING
  IN_DIAGNOSTICS
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  WAITING_FOR_PARTS
  COMPLETED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum DeliveryMethod {
  PICKUP
  HOME_DELIVERY
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  OUT_OF_STOCK
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  DAMAGE
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  username  String
  email     String   @unique
  password  String   @default("")
  phone     String
  address   String   @default("")
  avatar    String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers        Customer[]
  assignedTickets  Ticket[]        @relation("AssignedTickets")
  createdTickets   Ticket[]        @relation("CreatedTickets")
  statusUpdates    StatusHistory[]
  paymentRecords   PaymentHistory[]
  productsCreated  Product[]       @relation("ProductsCreated")
  stockMovements   StockMovement[]
  categoriesCreated Category[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  address   String   @default("")
  isVIP     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  tickets Ticket[]

  @@index([phone])
  @@index([name])
  @@index([createdById])
}

model Ticket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique

  // Customer & Device Info
  customerId       Int
  customer         Customer @relation(fields: [customerId], references: [id])
  deviceType       String
  brand            String
  serialNumber     String?
  issueDescription String   @db.Text

  // Assignment
  assignedToId String
  assignedTo   User   @relation("AssignedTickets", fields: [assignedToId], references: [id])

  // Status & Workflow
  status             TicketStatus   @default(PENDING)
  priority           Priority       @default(NORMAL)
  expectedReturnDate DateTime?

  // Diagnostic Phase
  diagnosticFee      Decimal @default(0) @db.Decimal(10, 2)
  diagnosticPaid     Boolean @default(false)
  diagnosticFindings String? @db.Text
  requiredParts      String? @db.Text

  // Repair Phase
  estimatedCost Decimal? @db.Decimal(10, 2)
  finalCost     Decimal? @db.Decimal(10, 2)
  laborCost     Decimal? @db.Decimal(10, 2)
  partsCost     Decimal? @db.Decimal(10, 2)

  // Payment
  totalAmount   Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?

  // Delivery
  deliveryMethod  DeliveryMethod @default(PICKUP)
  deliveryAddress String?
  deliveryFee     Decimal        @default(0) @db.Decimal(10, 2)

  // Tracking
  createdById String
  createdBy   User     @relation("CreatedTickets", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  // Relations
  statusHistory  StatusHistory[]
  paymentHistory PaymentHistory[]

  @@index([ticketNumber])
  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model StatusHistory {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status      TicketStatus
  notes       String?      @db.Text
  updatedById String
  updatedBy   User         @relation(fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([ticketId])
  @@index([updatedById])
}

model PaymentHistory {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String
  note          String?  @db.Text
  recordedById  String
  recordedBy    User     @relation(fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([ticketId])
  @@index([recordedById])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([name])
  @@index([createdById])
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique
  name            String
  description     String?          @db.Text
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  quantity        Int              @default(0)
  reorderLevel    Int              @default(5)
  unit            String           @default("pcs")
  purchasePrice   Decimal          @db.Decimal(10, 2)
  sellingPrice    Decimal          @db.Decimal(10, 2)
  profitMargin    Decimal          @default(0) @db.Decimal(5, 2)
  condition       ProductCondition @default(NEW)
  status          ProductStatus    @default(ACTIVE)
  image           String?
  supplier        String?
  lastRestockedAt DateTime?
  createdById     String
  createdBy       User             @relation("ProductsCreated", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  stockMovements StockMovement[]
  lowStockAlerts LowStockAlert[]

  @@index([sku])
  @@index([name])
  @@index([categoryId])
  @@index([status])
  @@index([createdById])
}

model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        MovementType
  quantity    Int
  reason      String
  notes       String?      @db.Text
  reference   String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model LowStockAlert {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  threshold Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}
