generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
  TECHNICIAN
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  username  String
  email     String   @unique
  password  String   @default("")
  phone     String
  avatar    String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@index([email])
  @@index([role])
}
